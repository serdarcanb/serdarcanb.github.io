---
// Icons are Phosphor (regular weight), inlined at build time. One family for the whole site.
import arrowUpRight from "@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw";
import arrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg?raw";
import sun from "@phosphor-icons/core/assets/regular/sun.svg?raw";
import moon from "@phosphor-icons/core/assets/regular/moon.svg?raw";
import list from "@phosphor-icons/core/assets/regular/list.svg?raw";
import caretDown from "@phosphor-icons/core/assets/regular/caret-down.svg?raw";
import envelope from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import linkedin from "@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw";
import github from "@phosphor-icons/core/assets/regular/github-logo.svg?raw";
import medium from "@phosphor-icons/core/assets/regular/medium-logo.svg?raw";
import calendar from "@phosphor-icons/core/assets/regular/calendar-plus.svg?raw";
import migrations from "@phosphor-icons/core/assets/regular/arrows-left-right.svg?raw";
import cost from "@phosphor-icons/core/assets/regular/chart-line-down.svg?raw";
import incidents from "@phosphor-icons/core/assets/regular/siren.svg?raw";
import observability from "@phosphor-icons/core/assets/regular/pulse.svg?raw";
import backup from "@phosphor-icons/core/assets/regular/clock-counter-clockwise.svg?raw";
import security from "@phosphor-icons/core/assets/regular/shield-check.svg?raw";
import platform from "@phosphor-icons/core/assets/regular/git-branch.svg?raw";
import databases from "@phosphor-icons/core/assets/regular/database.svg?raw";
import tooling from "@phosphor-icons/core/assets/regular/wrench.svg?raw";

const icons: Record<string, string> = {
  arrowUpRight, arrowRight, sun, moon, list, caretDown, envelope, linkedin, github, medium, calendar,
  migrations, cost, incidents, observability, backup, security, platform, tooling, databases,
};

interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = "" } = Astro.props;
const svg = (icons[name] ?? "").replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
---

<span class:list={["icon shrink-0", cls]} set:html={svg} />
